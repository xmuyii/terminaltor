# ==============================================================================
# SOVEREIGN ACADEMY: SUPABASE ENVIRONMENT CONFIGURATION (.env.local)
# ==============================================================================

# Supabase API Endpoint
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Client Key (Public Safe)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Supabase Service Role Key (Server-side ONLY / administrative tasks)
# NEVER expose this on the client or in client-side bundles!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Paystack Payment Gateway & Webhook Signature Secrets
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."
PAYSTACK_WEBHOOK_SECRET="sk_live_..."
