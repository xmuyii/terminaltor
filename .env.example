# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Phase 4 Multi-Timeframe Leaderboards & Redis Caching
REDIS_URL=redis://localhost:6379/0
LEADERBOARD_CACHE_TTL_DAILY=60
LEADERBOARD_CACHE_TTL_WEEKLY=300
LEADERBOARD_CACHE_TTL_MONTHLY=900
LEADERBOARD_CACHE_TTL_ALL_TIME=3600
LEADERBOARD_PAGE_SIZE_DEFAULT=25
LEADERBOARD_PAGE_SIZE_MAX=100

# Phase 6 Async Queue
REDIS_QUEUE_URL=redis://redis:6379/1
QUEUE_MAX_JOBS=50
QUEUE_JOB_TIMEOUT_SECONDS=15
QUEUE_RESULT_TTL_SECONDS=300
WORKER_CONCURRENCY=4

# Phase 6 Sandbox Isolation
SANDBOX_BACKEND=docker # docker | subprocess (dev fallback)
SANDBOX_IMAGE=lms-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=8
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_CPU_QUOTA=50000 # 50% of one core (Docker units)
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK=none
SANDBOX_POOL_SIZE=8 # pre-warmed containers

# Phase 6 Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PATH=/metrics
SENTRY_DSN=
TRACE_SAMPLE_RATE=0.1

# Phase 7 Real-time Multiplayer Arcade
GAME_HOST=0.0.0.0
GAME_PORT=8001
GAME_PUBLIC_WS_URL=wss://game.example.com/ws
GAME_INTERMISSION_SECONDS=30
GAME_MAX_PLAYERS_PER_ROOM=8
GAME_MAX_ROOMS=50
GAME_JWT_SECRET="sovereign_dev_secret_key_change_in_prod"

# Word Forge
WORDFORGE_ROUND_SECONDS=180
WORDFORGE_MIDROUND_AT_SECONDS=90
WORDFORGE_SEED_WORD_COUNT=2
WORDFORGE_SEED_WORD_LENGTH=6
WORDFORGE_MIDROUND_LETTERS=2
WORDFORGE_MIN_DISTINCT_LETTERS=15
WORDFORGE_SUBMIT_RATE_LIMIT_MS=400
WORDFORGE_FEED_BATCH_SIZE=4
WORDFORGE_FEED_BATCH_INTERVAL_MS=15000
WORDFORGE_FEED_VISIBLE_BATCHES=4
WORDFORGE_ENGLISH_STREAK_MAX=3

# Debugs Hunting

# Phase 5.5 Academy Alliances (B2B2C Seat-Based Subscriptions)
PAYSTACK_ACADEMY_PREMIUM_PLAN_CODE=PLN_academy_prem
PAYSTACK_ACADEMY_PRO_PLAN_CODE=PLN_academy_pro
ACADEMY_SEAT_CAP_PREMIUM=30
ACADEMY_SEAT_CAP_PRO=100
ACADEMY_PRICE_PREMIUM_KOBO=2500000     # ₦25,000/mo
ACADEMY_PRICE_PRO_KOBO=7500000         # ₦75,000/mo
