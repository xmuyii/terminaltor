{
  "defaultAction": "SCMP_ACT_ERRNO",
  "comment": "Minimal Seccomp Profile for Python 3.11 Sandbox Runner. Blocks all syscalls by default (SCMP_ACT_ERRNO), allowing only stdlib execution, memory allocations, standard I/O, and thread/process management necessary for CPython.",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_X86",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "names": [
        "read",
        "write",
        "open",
        "openat",
        "close",
        "fstat",
        "newfstatat",
        "stat",
        "lseek",
        "mmap",
        "mprotect",
        "munmap",
        "brk",
        "rt_sigaction",
        "rt_sigprocmask",
        "rt_sigreturn",
        "ioctl",
        "pread64",
        "pwrite64",
        "readv",
        "writev",
        "access",
        "faccessat",
        "faccessat2",
        "pipe",
        "pipe2",
        "select",
        "pselect6",
        "poll",
        "ppoll",
        "nanosleep",
        "clock_nanosleep",
        "gettimeofday",
        "clock_gettime",
        "clock_getres",
        "getpid",
        "gettid",
        "getuid",
        "geteuid",
        "getgid",
        "getegid",
        "getrlimit",
        "prlimit64",
        "sysinfo",
        "futex",
        "sched_yield",
        "sched_getaffinity",
        "exit",
        "exit_group",
        "getrandom",
        "arch_prctl",
        "set_tid_address",
        "set_robust_list",
        "rseq"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "Allowed core syscalls for CPython interpreter, basic I/O, memory allocation, and timing."
    }
  ]
}
